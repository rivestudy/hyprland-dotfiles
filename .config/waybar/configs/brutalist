/* Brutalist layout: flush to edges, tight spacing, compact center layout */
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 1,
"fixed-center": true,
"ipc": true,
"margin-top": 0,
"margin-left": 0,
"margin-right": 0,

"modules-left": [
	"tray",
        "custom/separator#blank",
        "custom/weather",
	],

"modules-center": [
        "hyprland/workspaces#alpha",
        "custom/separator#blank",
        "clock#4",
        "custom/separator#blank",
        "custom/playerctl",
	],

"modules-right": [
        "group/notify",
	"battery",
	"custom/separator#blank",
	"group/audio",
	"custom/separator#blank",
	"custom/power",
	],
}
